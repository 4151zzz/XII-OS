[Unit]
Description=XII OS Bluetooth Manager
Documentation=https://xii-os.org/docs/bluetooth
Requires=bluetooth.service
After=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/xii-os/system/bluetooth/xii-bluetooth.py status
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=bluetooth.target
