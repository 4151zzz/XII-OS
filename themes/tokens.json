{
  "$schema": "https://xii-os.org/schemas/design-tokens/v1",
  "meta": {
    "name": "XII OS Design System",
    "version": "1.0.0",
    "description": "Canonical design tokens for XII OS desktop environment — colors, typography, spacing, radii, shadows, animations"
  },

  "color": {
    "comment": "All colors defined in HSL for easy theming and adjustment",

    "base": {
      "bg-deep":        { "value": "hsl(240, 15%, 4%)",   "description": "Deepest background — space black" },
      "bg-base":        { "value": "hsl(240, 12%, 7%)",   "description": "Primary background surface" },
      "bg-elevated":    { "value": "hsl(240, 10%, 11%)",  "description": "Elevated cards, panels" },
      "bg-overlay":     { "value": "hsl(240,  9%, 15%)",  "description": "Floating overlays, dropdowns" },
      "bg-glass":       { "value": "hsla(240, 15%, 100%, 0.06)", "description": "Glassmorphism base fill" },
      "bg-glass-hover": { "value": "hsla(240, 15%, 100%, 0.10)", "description": "Glassmorphism hover state" }
    },

    "accent": {
      "cyan":       { "value": "hsl(190, 90%, 70%)",  "description": "XII Primary — Electric Cyan" },
      "cyan-dim":   { "value": "hsl(190, 60%, 45%)",  "description": "XII Cyan muted" },
      "cyan-glow":  { "value": "hsla(190, 90%, 70%, 0.25)", "description": "Cyan ambient glow" },
      "purple":     { "value": "hsl(260, 80%, 72%)",  "description": "XII Identity — Soft Violet" },
      "purple-dim": { "value": "hsl(260, 50%, 50%)",  "description": "XII Purple muted" },
      "rose":       { "value": "hsl(330, 75%, 68%)",  "description": "XII Tertiary — Warm Rose" },
      "rose-dim":   { "value": "hsl(330, 45%, 48%)",  "description": "XII Rose muted" }
    },

    "semantic": {
      "success":  { "value": "hsl(142, 70%, 55%)", "description": "Positive / success state" },
      "warning":  { "value": "hsl( 38, 90%, 60%)", "description": "Caution / warning state" },
      "error":    { "value": "hsl(  4, 80%, 60%)", "description": "Destructive / error state" },
      "info":     { "value": "hsl(210, 85%, 65%)", "description": "Informational state" }
    },

    "text": {
      "primary":   { "value": "hsl(240, 10%, 92%)",  "description": "Primary readable text" },
      "secondary": { "value": "hsl(240,  8%, 68%)",  "description": "Secondary / supporting text" },
      "muted":     { "value": "hsl(240,  6%, 45%)",  "description": "Dimmed / placeholder text" },
      "inverse":   { "value": "hsl(240, 15%,  6%)",  "description": "Text on light backgrounds" },
      "accent":    { "value": "hsl(190, 90%, 70%)",  "description": "Highlighted / link text" }
    },

    "border": {
      "subtle":  { "value": "hsla(240, 20%, 100%, 0.07)", "description": "Hairline divider" },
      "default": { "value": "hsla(240, 20%, 100%, 0.12)", "description": "Standard border" },
      "strong":  { "value": "hsla(240, 20%, 100%, 0.20)", "description": "Emphasized border" },
      "focus":   { "value": "hsl(190, 90%, 70%)",         "description": "Focus ring" }
    }
  },

  "typography": {
    "font": {
      "sans":  { "value": "'Inter', 'Noto Sans', system-ui, sans-serif" },
      "mono":  { "value": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace" },
      "display": { "value": "'Inter', 'Outfit', system-ui, sans-serif" }
    },
    "size": {
      "xs":   { "value": "11px" },
      "sm":   { "value": "13px" },
      "base": { "value": "14px", "description": "Desktop UI default" },
      "md":   { "value": "15px" },
      "lg":   { "value": "18px" },
      "xl":   { "value": "22px" },
      "2xl":  { "value": "28px" },
      "3xl":  { "value": "36px" },
      "4xl":  { "value": "48px" }
    },
    "weight": {
      "light":    { "value": "300" },
      "regular":  { "value": "400" },
      "medium":   { "value": "500" },
      "semibold": { "value": "600" },
      "bold":     { "value": "700" }
    },
    "leading": {
      "tight":  { "value": "1.2" },
      "normal": { "value": "1.5" },
      "loose":  { "value": "1.8" }
    },
    "tracking": {
      "tight":  { "value": "-0.02em" },
      "normal": { "value": "0em" },
      "wide":   { "value": "0.04em" },
      "wider":  { "value": "0.10em" },
      "widest": { "value": "0.20em" }
    }
  },

  "spacing": {
    "0":  { "value": "0px" },
    "1":  { "value": "4px" },
    "2":  { "value": "8px" },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "20px" },
    "6":  { "value": "24px" },
    "8":  { "value": "32px" },
    "10": { "value": "40px" },
    "12": { "value": "48px" },
    "16": { "value": "64px" },
    "20": { "value": "80px" }
  },

  "radius": {
    "none":  { "value": "0px" },
    "sm":    { "value": "6px" },
    "md":    { "value": "10px", "description": "Default UI radius" },
    "lg":    { "value": "14px" },
    "xl":    { "value": "20px", "description": "Panel / card radius" },
    "2xl":   { "value": "28px", "description": "Large modal radius" },
    "full":  { "value": "9999px", "description": "Pills and badges" }
  },

  "shadow": {
    "sm":    { "value": "0 1px  4px hsla(240,20%,0%,0.25)" },
    "md":    { "value": "0 4px 12px hsla(240,20%,0%,0.35), 0 1px 3px hsla(240,20%,0%,0.2)" },
    "lg":    { "value": "0 8px 24px hsla(240,20%,0%,0.45), 0 2px 6px  hsla(240,20%,0%,0.25)" },
    "xl":    { "value": "0 16px 48px hsla(240,20%,0%,0.55), 0 4px 12px hsla(240,20%,0%,0.3)" },
    "glow-cyan":   { "value": "0 0 20px hsla(190,90%,70%,0.30), 0 0 60px hsla(190,90%,70%,0.10)" },
    "glow-purple": { "value": "0 0 20px hsla(260,80%,72%,0.25), 0 0 60px hsla(260,80%,72%,0.08)" }
  },

  "blur": {
    "none":  { "value": "0px" },
    "sm":    { "value": "8px",  "description": "Lite Mode glassmorphism" },
    "md":    { "value": "16px", "description": "Standard Mode glassmorphism" },
    "lg":    { "value": "24px", "description": "Performance Mode glassmorphism" },
    "xl":    { "value": "40px", "description": "Deep background blur" }
  },

  "animation": {
    "duration": {
      "instant": { "value": "80ms" },
      "fast":    { "value": "150ms" },
      "normal":  { "value": "250ms" },
      "slow":    { "value": "400ms" },
      "slower":  { "value": "600ms" }
    },
    "easing": {
      "linear":      { "value": "linear" },
      "ease":        { "value": "cubic-bezier(0.4, 0, 0.2, 1)" },
      "ease-in":     { "value": "cubic-bezier(0.4, 0, 1, 1)" },
      "ease-out":    { "value": "cubic-bezier(0, 0, 0.2, 1)" },
      "spring":      { "value": "cubic-bezier(0.175, 0.885, 0.32, 1.275)", "description": "Springy overshoot" },
      "smooth":      { "value": "cubic-bezier(0.25, 0.46, 0.45, 0.94)" }
    }
  },

  "size": {
    "statusbar-height": { "value": "34px",  "description": "Top status bar height" },
    "dock-height":      { "value": "64px",  "description": "Dock icon size" },
    "dock-padding":     { "value": "10px",  "description": "Dock internal padding" },
    "icon-xs":          { "value": "16px" },
    "icon-sm":          { "value": "22px" },
    "icon-md":          { "value": "32px" },
    "icon-lg":          { "value": "48px" },
    "icon-xl":          { "value": "64px" }
  }
}
